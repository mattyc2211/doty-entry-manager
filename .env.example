# Copy to .env and fill in from your Supabase project:
#   Project Settings -> API
#
# Both values are public. The anon key is compiled into the browser bundle by
# design and identifies the project; it grants nothing on its own. Data safety
# comes from the RLS policies in supabase/migrations, not from hiding this.
#
# Never put the service_role key in here. It bypasses RLS entirely and would be
# shipped to every visitor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local development against `supabase start` uses the ports set in
# supabase/config.toml, which are shifted off the defaults:
#   VITE_SUPABASE_URL=http://127.0.0.1:54421
